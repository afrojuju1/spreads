flowchart TB
    %% Current Spreads architecture. Source of truth: docs/current_system_state.md

    classDef operator fill:#eef6ff,stroke:#2563eb,color:#0f172a
    classDef service fill:#f8fafc,stroke:#475569,color:#0f172a
    classDef domain fill:#ecfdf5,stroke:#059669,color:#052e16
    classDef storage fill:#fff7ed,stroke:#ea580c,color:#431407
    classDef external fill:#fdf2f8,stroke:#be185d,color:#500724
    classDef optional fill:#f5f3ff,stroke:#7c3aed,color:#2e1065,stroke-dasharray: 5 5

    subgraph Operators["Operator Surfaces"]
        Browser["Browser operator"]
        CLI["spreads CLI"]
    end

    subgraph Deploy["Live Deploy Target: Docker Compose on ade-nucbox-k8-plus"]
        Web["Next.js web\npackages/web"]
        API["FastAPI API\npackages/api"]
        Scheduler["Scheduler\npackages/core/jobs"]
        WorkerRuntime["runtime workers\nbroker sync, strategy entry/manage, lifecycle start, alerts"]
        WorkerData["data worker\nticker sources"]
        WorkerValuation["valuation worker\noptional, disabled by default"]
        WorkerResearch["research worker\noptional, disabled by default"]
        MarketRecorder["market recorder\nAlpaca option websocket owner"]
    end

    subgraph Config["Authored Configuration"]
        StrategyConfig["strategy catalog + profiles\npackages/config/strategies"]
        TickerConfig["ticker source configs\npackages/config/ticker_sources"]
        JobConfig["job configs + generated strategy routines\npackages/config/jobs"]
    end

    subgraph Core["Core Domain Services: packages/core/services"]
        OpsReadModels["TradingOpsState + StorageOpsState\nservices/ops, positions, execution runtimes"]
        StrategyRuntime["StrategyRuntime\nentry orchestration + decision persistence"]
        PortfolioRuntime["PortfolioEngine + RiskEngine\nclose policy, admission, position readiness"]
        DataEngine["DataEngine\nticker resolution + candidate inputs"]
        TickerSources["Ticker source service\nmaterialized universes"]
        CandidateBuilders["Strategy candidate builders\noption structures, ranking, diagnostics"]
        EntrySelection["EntrySelectionEngine\nquality, selected, monitored, rejected"]
        CaptureTargets["Capture target service\ndesired option stream state"]
        ExecutionIntents["Execution intents\ncontrol-plane handoff"]
        ExecutionRuntime["Execution services\nalpaca_direct submit, refresh, cancel"]
        BrokerSync["Broker sync\naccount, orders, fills, broker positions"]
        Alerts["Alert delivery + reconcile"]
        CompanyValuation["Company valuation services\noptional offline lane"]
        TradingAgentsScan["TradingAgents scan orchestration\noptional research lane"]
    end

    subgraph Persistence["Persistence + Transport"]
        Postgres[("Postgres\ndomain + ops source of truth")]
        ClickHouse[("ClickHouse\nraw option ticks + quote snapshots")]
        Redis[("Redis\nqueues, leases, pub/sub")]
        Artifacts["outputs + logs\nresearch artifacts, alerts, runtime logs"]
    end

    subgraph External["External Systems"]
        AlpacaAccount["Alpaca account + trading API"]
        AlpacaMarket["Alpaca market data\nsnapshots, chains, option websocket"]
        Finviz["Finviz screener"]
        TradingAgents["external/TradingAgents\nsymlink to /home/ade/Projects/TradingAgents"]
        AlertTargets["alert targets\nwebhooks/operators"]
    end

